# Copy to .env and fill in. .env is ignored by git and by Posit Connect
# deploys; on Connect set the same names under the content's Advanced tab,
# Environment variables, instead.

# Databricks workspace URL, with https:// and no trailing slash
DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net

# Access token (Settings, Developer, Access tokens). Scope: sql. A personal token
# carries your own access and stops working if it expires or your access changes. For
# the deployed app, use a service principal's token with SELECT on the schema below
# only, never on the restricted schema.
DATABRICKS_TOKEN=

# SQL warehouse id: the last segment of the warehouse's HTTP path,
# e.g. /sql/1.0/warehouses/abc123 gives abc123
DATABRICKS_WAREHOUSE_ID=

# Unity Catalog location of the FGS tables (CATALOG and SCHEMA in the
# pipeline's config.py)
FGS_CATALOG=prd_dash_lab
FGS_SCHEMA=flood_forecasting_unrestricted

# --- Optional -------------------------------------------------------------

# Must match FGS_GEOMETRY_SOURCE in the pipeline's config.py: risk_areas or aoc
FGS_GEOMETRY_SOURCE=risk_areas

# Seconds between checks for new pipeline data. 0 turns auto-refresh off.
# Otherwise at least 30.
FGS_AUTO_REFRESH_SECONDS=120

# Hours without a pipeline health update before the stale-data banner shows
FGS_STALE_HOURS=3

# How many times a query is retried after a network failure (not after a SQL
# error). 0 turns retrying off. Max 5. Each retry waits 1.5 s, then 3 s.
FGS_QUERY_RETRIES=2

# Seconds query results are reused across sessions. 0 turns the cache off.
FGS_CACHE_SECONDS=600

# How many map-geometry results the shared cache keeps (oldest dropped first), so
# memory stays bounded however much people browse. Default 30.
# FGS_CACHE_GEOMETRY_ENTRIES=30

# Share of a flood warning or alert area that must lie inside a constituency for it
# to count as under that constituency's forecast. Match WARNING_CONTACT_MIN_PCT in the
# pipeline's config.py. Default 0.01 (1%).
# FGS_WARNING_CONTACT_MIN_PCT=0.01

# Share of a constituency a forecast polygon must cover, used only to rebuild past
# statements in the look-back. Match FGS_CONTACT_MIN_PCT in the pipeline's config.py.
# FGS_CONTACT_MIN_PCT=0.01

# Proof-of-concept features (the statement look-back). 1 (default) shows them,
# 0 hides them. Remove them for go-live; see README.
# FGS_POC_FEATURES=1

# The app switches off the progress pop-ups ("Submitting query" and the like) that the
# Databricks driver would otherwise draw on screen for every query. Set to 1 to see them
# again, for example when a query seems stuck.
# FGS_SHOW_QUERY_PROGRESS=1

# Run the whole app on generated, fictional data with NO warehouse connection.
# With this set, none of the Databricks variables above are needed.
# FGS_DEMO_MODE=1
