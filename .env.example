# Copy to .env and fill in. .env is ignored by git and by Posit Connect
# deploys; on Connect set the same names in the app's Vars panel instead.

# Databricks workspace URL, with https:// and no trailing slash
DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net

# Personal access token (Settings, Developer, Access tokens). Scope: sql.
DATABRICKS_TOKEN=

# SQL warehouse id: the last segment of the warehouse's HTTP path,
# e.g. /sql/1.0/warehouses/abc123 gives abc123
DATABRICKS_WAREHOUSE_ID=

# Unity Catalog location of the FGS tables (CATALOG and SCHEMA in the
# pipeline's config.py)
FGS_CATALOG=prd_dash_lab
FGS_SCHEMA=flood_forecasting_unrestricted

# --- Optional -------------------------------------------------------------

# Must match FGS_GEOMETRY_SOURCE in the pipeline's config.py: risk_areas or aoc
FGS_GEOMETRY_SOURCE=risk_areas

# Seconds between checks for new pipeline data. 0 turns auto-refresh off.
# Otherwise at least 30.
FGS_AUTO_REFRESH_SECONDS=120

# Hours without a pipeline health update before the stale-data banner shows
FGS_STALE_HOURS=3

# How many times a query is retried after a network failure (not after a SQL
# error). 0 turns retrying off. Max 5. Each retry waits 1.5 s, then 3 s.
FGS_QUERY_RETRIES=2

# Seconds query results are reused across sessions. 0 turns the cache off.
FGS_CACHE_SECONDS=600

# Run the whole app on generated, fictional data with NO warehouse connection.
# With this set, none of the Databricks variables above are needed.
# FGS_DEMO_MODE=1
